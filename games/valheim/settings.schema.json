{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Valheim settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "world", "password"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "default": "Valheim Server" },
    "world": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "default": "Dedicated" },
    "password": {
      "description": "Server requires at least 5 characters and must not contain the server name.",
      "type": "string",
      "minLength": 5,
      "x-secret": true,
      "x-generate": "password"
    },
    "public": { "type": "boolean", "default": false }
  }
}
